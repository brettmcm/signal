---
import CapsuleFrame from "../../../components/CapsuleFrame.astro";
import { metadata } from "./meta";

const phases = [
  { name: "Discover", dates: "Aug 3 — Sep 4", left: 0, width: 704, top: 126, tasks: [["Client interviews", true], ["Competitive audit", true], ["Audience profiles", true], ["Brand workshop", false], ["Creative brief", false]] },
  { name: "Define & design", dates: "Aug 24 — Oct 2", left: 448, width: 832, top: 362, tasks: [["Positioning territories", true], ["Visual directions", false], ["Identity system", false], ["Typography study", false], ["Color system", false], ["Core applications", false], ["Design review", false]] },
  { name: "Launch", dates: "Oct 5 — Oct 30", left: 1344, width: 576, top: 126, tasks: [["Brand guidelines", false], ["Template toolkit", false], ["Asset handoff", false], ["Team training", false]] },
];

const milestones = [["Kickoff", "Aug 3", 0], ["Strategy approved", "Sep 4", 704], ["Identity approved", "Oct 2", 1280], ["Launch", "Oct 30", 1920]];
---

<CapsuleFrame metadata={metadata}>
  <div class="timeline-shell">
    <div class="timeline-scroll" tabindex="0" aria-label="Horizontally scrolling brand identity project timeline, August through October">
      <div class="timeline">
        <div class="timeline-axis" aria-hidden="true"><time>Aug 3</time><span></span><time>Oct 30</time></div>
        {phases.map((phase) => (
          <article class="timeline-phase" style={`--top:${phase.top}px;--left:${phase.left}px;--width:${phase.width}px`}>
            <span class="phase-rail" aria-hidden="true"></span>
            <div class="phase-content">
              <header><h2>{phase.name}</h2><time>{phase.dates}</time></header>
              <ul>{phase.tasks.map(([task, complete]) => <li class:list={{ complete }}><span aria-hidden="true">{complete ? "✓" : ""}</span><strong>{task}</strong></li>)}</ul>
            </div>
          </article>
        ))}
        {milestones.map(([title, date, left], index) => (
          <div class:list={["milestone", { end: index === milestones.length - 1 }]} style={`--left:${left}px`}><span aria-hidden="true"></span><div><strong>{title}</strong><time>{date}</time></div></div>
        ))}
      </div>
    </div>
  </div>
</CapsuleFrame>

<style>
  .timeline-shell { min-width: 0; padding-bottom: 24px; overflow: hidden; color: var(--ink); background: var(--canvas); }
  .timeline-scroll { width: 100%; overflow-x: auto; overflow-y: hidden; cursor: grab; scrollbar-width: none; overscroll-behavior-x: contain; }
  .timeline-scroll:active { cursor: grabbing; }
  .timeline-scroll::-webkit-scrollbar { display: none; }
  .timeline { --edge: 28px; --timeline-width: 1920px; --indicator: color-mix(in srgb, var(--tertiary) 52%, transparent); position: relative; width: calc(var(--timeline-width) + 2 * var(--edge)); height: 660px; padding-left: var(--edge); }
  .timeline-axis { position: absolute; top: 22px; left: var(--edge); width: var(--timeline-width); height: 33px; display: grid; grid-template: 22px 1px / 1fr 1fr; row-gap: 10px; color: var(--tertiary); font: 400 10px/16px var(--font-mono); }
  .timeline-axis span { position: relative; grid-column: 1/-1; grid-row: 2; height: 1px; background: var(--indicator); }
  .timeline-axis span::before, .timeline-axis span::after { position: absolute; top: -2px; width: 5px; height: 5px; border-radius: 50%; background: var(--indicator); content: ""; }
  .timeline-axis span::before { left: -2px; } .timeline-axis span::after { right: -2px; }
  .timeline-axis time:first-child { grid-column: 1; grid-row: 1; justify-self: start; } .timeline-axis time:last-child { grid-column: 2; grid-row: 1; justify-self: end; }
  .timeline-phase { position: absolute; z-index: 1; top: var(--top); left: calc(var(--edge) + var(--left)); width: var(--width); }
  .phase-rail { position: absolute; top: 5px; right: 0; left: 0; height: 2px; background: var(--interaction); }
  .phase-rail::before { position: absolute; top: -4px; left: 0; width: 9px; height: 9px; border-radius: 50%; background: var(--interaction); content: ""; }
  .phase-content { padding: 22px 18px 0 0; }
  .phase-content header { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .phase-content h2 { margin: 0; overflow: hidden; color: var(--interaction); font: 500 13px/17px var(--font-ui); text-overflow: ellipsis; white-space: nowrap; }
  .phase-content time { color: var(--tertiary); font: 400 10px/16px var(--font-mono); white-space: nowrap; }
  .phase-content ul { display: grid; justify-items: start; gap: 8px; margin-top: 16px; padding: 0; list-style: none; }
  .phase-content li { min-height: 20px; display: grid; grid-template-columns: 12px minmax(0,1fr); align-items: center; gap: 8px; color: var(--ink); }
  .phase-content li > span { width: 12px; height: 12px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--muted); font-size: 8px; }
  .phase-content strong { overflow: hidden; font: 500 12px/16px var(--font-ui); text-overflow: ellipsis; white-space: nowrap; }
  .phase-content .complete { color: var(--tertiary); }
  .phase-content .complete > span { border-color: var(--interaction); background: var(--interaction); color: var(--canvas); }
  .phase-content .complete strong { text-decoration: line-through; }
  .milestone { position: absolute; z-index: 3; top: 39px; left: calc(var(--edge) + var(--left)); min-height: 48px; color: var(--interaction); }
  .milestone > span { position: absolute; top: 13.5px; left: -3px; width: 6px; height: 6px; background: var(--interaction); clip-path: polygon(50% 0,100% 50%,50% 100%,0 50%); }
  .milestone > div { position: absolute; top: 32px; left: -3px; display: flex; align-items: baseline; gap: 7px; white-space: nowrap; }
  .milestone.end > div { right: -3px; left: auto; justify-content: flex-end; }
  .milestone strong { font-size: 12px; font-weight: 500; } .milestone time { color: var(--tertiary); font: 400 10px/16px var(--font-mono); }
  @media (max-width: 700px) { .timeline { height: 620px; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".timeline-scroll").forEach((scroller) => {
    if (scroller.dataset.dragReady === "true") return;
    scroller.dataset.dragReady = "true";
    let startX = 0, startLeft = 0, dragging = false;
    scroller.addEventListener("pointerdown", (event) => { dragging = true; startX = event.clientX; startLeft = scroller.scrollLeft; scroller.setPointerCapture(event.pointerId); });
    scroller.addEventListener("pointermove", (event) => { if (dragging) scroller.scrollLeft = startLeft - (event.clientX - startX); });
    const stop = () => { dragging = false; };
    scroller.addEventListener("pointerup", stop);
    scroller.addEventListener("pointercancel", stop);
  });
</script>
