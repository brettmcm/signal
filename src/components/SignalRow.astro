---
import type { NumberedSignal } from "../lib/signals";
import { signalPath } from "../lib/signals";

interface Props {
  signal: NumberedSignal;
}

const { signal } = Astro.props;
---

<article class="signal-row">
  <a href={signalPath(signal)}>
    <span class="signal-index" aria-label={`Signal ${signal.signalNumber}`}>
      {signal.signalNumber}
    </span>
    <span class="signal-copy">
      <span class="signal-title">{signal.data.title}</span>
    </span>
  </a>
</article>
