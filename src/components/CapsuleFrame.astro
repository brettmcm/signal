---
import {
  capsuleLabel,
  type CapsuleMetadata,
} from "../lib/capsules";

interface Props {
  metadata: CapsuleMetadata;
}

const { metadata } = Astro.props;
const label = capsuleLabel(metadata);
---

<p class="signal-capsule-citation" data-capsule-citation aria-hidden="true">
  {label}
</p>
<aside
  id={`capsule-${metadata.signalNumber}-${metadata.capsuleNumber}`}
  class="signal-capsule"
  aria-label={metadata.title ? `${label}: ${metadata.title}` : label}
  data-capsule
  data-signal-number={metadata.signalNumber}
  data-capsule-number={metadata.capsuleNumber}
>
  <div class="signal-capsule__content">
    <slot />
  </div>
  <p class="signal-capsule__caption">{label}</p>
</aside>

<style>
  .signal-capsule {
    color: var(--ink);
  }

  .signal-capsule-citation {
    display: none;
    color: var(--tertiary);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1;
    white-space: nowrap;
  }

  .signal-capsule__content {
    display: flex;
    min-width: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--canvas);
  }

  .signal-capsule__caption {
    margin-top: 10px;
    padding: 0;
    color: var(--tertiary);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
  }

  .signal-capsule__content > :global(*) {
    width: 100%;
  }

  @media (min-width: 1060px) {
    .signal-capsule-citation {
      position: relative;
      display: block;
      width: fit-content;
      margin-top: 2.5em;
      padding-right: 8px;
      background: var(--canvas);
    }

    .signal-capsule-citation::after {
      position: absolute;
      z-index: -1;
      top: 50%;
      left: 100%;
      width: var(--capsule-connector-width, 0px);
      height: 1px;
      background: var(--line);
      content: "";
    }

  }
</style>
