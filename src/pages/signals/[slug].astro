---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedSignals } from "../../lib/signals";

export const prerender = true;

export async function getStaticPaths() {
  const signals = await getPublishedSignals();
  return signals.map((signal) => ({
    params: { slug: signal.id.replace(/\.(md|mdx)$/, "") },
    props: { signal },
  }));
}

const { signal } = Astro.props;
const { Content } = await render(signal);
---

<BaseLayout
  title={signal.data.title}
  description={signal.data.description}
  image={signal.data.image}
  article
>
  <article class="article">
    <header class="article-header">
      <div class="article-heading">
        <p class="article-meta">
          <span aria-label={`Signal ${signal.signalNumber}`}>
            {signal.signalNumber}
          </span>
        </p>
        <h1>{signal.data.title}</h1>
      </div>
    </header>
    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<script>
  const articleBody = document.querySelector<HTMLElement>(".article-body");

  if (articleBody) {
    let layoutFrame = 0;

    const layoutCapsules = () => {
      window.cancelAnimationFrame(layoutFrame);
      layoutFrame = window.requestAnimationFrame(() => {
        const capsules = [
          ...articleBody.querySelectorAll<HTMLElement>("[data-capsule]"),
        ];

        articleBody.style.minHeight = "";
        capsules.forEach((capsule) => {
          capsule.style.top = "";
        });

        const railIsActive = capsules.some(
          (capsule) => getComputedStyle(capsule).position === "absolute",
        );

        if (!railIsActive || capsules.length === 0) return;

        const naturalHeight = articleBody.offsetHeight;
        const gap = 32;
        const railBottomClearance = 50;
        let railBottom = 0;

        capsules.forEach((capsule) => {
          const citation = capsule.previousElementSibling instanceof HTMLElement &&
            capsule.previousElementSibling.matches("[data-capsule-citation]")
              ? capsule.previousElementSibling
              : null;
          const anchorTop = citation
            ? citation.offsetTop + citation.offsetHeight / 2
            : capsule.offsetTop;
          const centeredTop = anchorTop - capsule.offsetHeight / 2;
          const top = Math.max(centeredTop, railBottom, 0);
          capsule.style.top = `${top}px`;

          if (citation) {
            const citationRect = citation.getBoundingClientRect();
            const capsuleRect = capsule.getBoundingClientRect();
            citation.style.setProperty(
              "--capsule-connector-width",
              `${Math.max(capsuleRect.left - citationRect.right, 0)}px`,
            );
            citation.style.zIndex = "1";
          }

          railBottom = top + capsule.offsetHeight + gap;
        });

        articleBody.style.minHeight = `${Math.max(
          naturalHeight,
          railBottom - gap + railBottomClearance,
        )}px`;
      });
    };

    const observer = new ResizeObserver(layoutCapsules);
    observer.observe(articleBody);
    articleBody.querySelectorAll<HTMLElement>("[data-capsule]").forEach((capsule) => {
      observer.observe(capsule);
    });

    window.addEventListener("resize", layoutCapsules);
    window.addEventListener("load", layoutCapsules, { once: true });
    layoutCapsules();
  }
</script>
